(rule
 (targets data.ml)
 (deps
  (:data
   (source_tree ../data)))
 (action
  (run %{bin:ocaml-crunch} -m plain ../data -o %{targets})))

(executable
 (name stone)
 (public_name stone)
 (modules conf data gen rule stone_inotify stone template util watch)
 (libraries
  astring
  bos
  cmarkit
  cow
  otoml
  (select
   stone_inotify.ml
   from
   (inotify -> stone_inotify.real.ml)
   (-> stone_inotify.fake.ml))
  rresult
  str
  unix))
